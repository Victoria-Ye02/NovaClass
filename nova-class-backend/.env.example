GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-vision-service-account.json
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=nova_class
JWT_SECRET=
PORT=5001
RAG_URL=http://localhost:8000
TOPIK_AI_URL=http://localhost:8010
# K.MATE's RAG brain — nova-class-ai (separate Python FastAPI service: Gemini
# + ChromaDB over the official TOPIK II exam papers). Needs its own
# GEMINI_API_KEY/CHROMA_HOST/CHROMA_PORT in that service's own .env.
KMATE_AI_URL=http://localhost:8082
GOOGLE_CLIENT_ID=
ELEVENLABS_API_KEY=
# Conversational AI agent id (elevenlabs.io -> Conversational AI -> your agent).
# Powers K.MATE's "Talk to Nova" voice call (GET /api/ai/voice-signed-url);
# without it that endpoint 503s.
ELEVENLABS_AGENT_ID=
# Faster English/Korean/Vietnamese teaching voice. Set eleven_multilingual_v2
# when voice quality matters more than conversation speed.
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
# Burmese TTS (ElevenLabs has no Burmese voice). By default this needs NOTHING
# configured — it uses the my-MM-NilarNeural neural voice for free via
# Microsoft Edge's Read Aloud endpoint. To upgrade to the official Azure Speech
# API (higher quota / SLA), set both of these; the voice is identical.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional — overrides the voice (default my-MM-NilarNeural, female;
# my-MM-ThihaNeural is male). Applies to both the free and the Azure path.
AZURE_SPEECH_VOICE=
