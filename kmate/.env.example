# K.Mate answers with Claude (KMATE_AI_PROVIDER=claude) or OpenAI; set the key of the one you use
KMATE_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# Only used when kmate/chroma_local is missing (run scripts/build_local_chroma.py to create it)
CHROMA_HOST=
CHROMA_PORT=
# Only needed for /quiz/* and /exam/* endpoints (question_bank / topik_questions tables)
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=nova_class
